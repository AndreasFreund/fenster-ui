{
  "name": "@andreasfreund/fenster-ui",
  "version": "0.1.0",
  "description": "A compact desktop-style component framework on React Aria Components",
  "keywords": [
    "react",
    "react-aria",
    "components",
    "ui",
    "desktop",
    "design-system"
  ],
  "license": "MIT",
  "author": "Andreas Freund <andreas.freund@posteo.de>",
  "homepage": "https://andreasfreund.github.io/fenster-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreasFreund/fenster-ui.git",
    "directory": "packages/fenster-ui"
  },
  "bugs": {
    "url": "https://github.com/AndreasFreund/fenster-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/fonts.css dist/fonts.css",
    "watch": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.0"
  }
}
